<Application x:Class="TwentyFourAqSSTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="DisclaimerWindow.xaml">
    <Application.Resources>

        <!-- 24aq Hacker Green palette -->
        <SolidColorBrush x:Key="Bg0" Color="#070B08"/>
        <SolidColorBrush x:Key="Bg1" Color="#0A110C"/>
        <SolidColorBrush x:Key="Bg2" Color="#0D1710"/>
        <SolidColorBrush x:Key="Bg3" Color="#111E15"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#1F4A2D"/>
        <SolidColorBrush x:Key="PanelBorderHot" Color="#35E872"/>
        <SolidColorBrush x:Key="Accent" Color="#39FF88"/>
        <SolidColorBrush x:Key="AccentMuted" Color="#1D9E56"/>
        <SolidColorBrush x:Key="AccentDark" Color="#0B4023"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E9FFF0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8BB99A"/>
        <SolidColorBrush x:Key="TextDim" Color="#52735D"/>
        <SolidColorBrush x:Key="Danger" Color="#FF6464"/>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#102417"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#245D36"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#173820"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#39FF88"/>
                                <Setter Property="Foreground" Value="#061109"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabRoot" Property="Background" Value="#112619"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#080E0A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="#1D4A2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
    </Application.Resources>
</Application>